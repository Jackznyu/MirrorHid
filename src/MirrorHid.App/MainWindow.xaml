<Window x:Class="MirrorHid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="MirrorHid"
        Width="430"
        Height="800"
        MinWidth="220"
        MinHeight="320"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border BorderBrush="#FF38A7FF" BorderThickness="2" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="#F01C2430"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MirrorHid overlay"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText"
                                   Text="Starting Bluetooth…"
                                   Foreground="#FFB7C7D9"
                                   FontSize="10" />
                    </StackPanel>

                    <Button x:Name="ToggleButton"
                            Grid.Column="1"
                            Content="Enable  F8"
                            Margin="8,5"
                            Padding="12,0"
                            Click="ToggleButton_Click" />
                    <Button x:Name="OpacityButton"
                            Grid.Column="2"
                            Content="Solid UI"
                            Margin="0,5,4,5"
                            Padding="8,0"
                            Click="OpacityButton_Click" />
                    <Button Grid.Column="3"
                            Content="Hide"
                            ToolTip="Temporarily hide MirrorHid; select it on the taskbar to restore"
                            Margin="0,5,4,5"
                            Padding="8,0"
                            Click="HideButton_Click" />
                    <Button Grid.Column="4"
                            Content="Reset Size"
                            ToolTip="Restore the original overlay size"
                            Margin="0,5,4,5"
                            Padding="6,0"
                            Click="ResetSizeButton_Click" />
                    <Button Grid.Column="5"
                            Content="✕"
                            Width="30"
                            Height="30"
                            Margin="2"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border x:Name="ActiveBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#B0202834"
                    CornerRadius="6,6,0,0"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ActiveBannerText"
                           Text="F9 NATIVE HOLD AND DRAG  •  F10 calibrates"
                           Foreground="#DFFFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border x:Name="ControlSurface"
                    Grid.Row="1"
                    Background="#300078D4"
                    CornerRadius="0,0,6,6"
                    Focusable="True"
                    MouseEnter="ControlSurface_MouseEnter"
                    MouseLeave="ControlSurface_MouseLeave"
                    MouseLeftButtonDown="ControlSurface_MouseLeftButtonDown"
                    MouseLeftButtonUp="ControlSurface_MouseLeftButtonUp"
                    MouseWheel="ControlSurface_MouseWheel">
                <Grid>
                    <ScrollViewer x:Name="Instructions"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="12">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="390">
                            <TextBlock Text="AssistiveTouch macro slots"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="HotkeySummaryText"
                                       Margin="0,8,0,0"
                                       Text="F10 starts/finishes recording."
                                       Foreground="#FFE0EBF5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0" Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Enable / release"
                                           Foreground="White" VerticalAlignment="Center" />
                                <Button x:Name="ToggleControlHotkeyButton" Grid.Row="0" Grid.Column="1"
                                        Tag="ToggleControl" Content="F8" Margin="4,2"
                                        Click="HotkeyCaptureButton_Click" />
                                <TextBlock Grid.Row="1" Text="Start / finish recording"
                                           Foreground="White" VerticalAlignment="Center" />
                                <Button x:Name="RecordModeHotkeyButton" Grid.Row="1" Grid.Column="1"
                                        Tag="RecordMode" Content="F10" Margin="4,2"
                                        Click="HotkeyCaptureButton_Click" />
                            </Grid>

                            <Grid Margin="0,12,0,0" Width="390">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="#FFB7C7D9" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Key" Foreground="#FFB7C7D9" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Speed" Foreground="#FFB7C7D9" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Steps" Foreground="#FFB7C7D9" />

                                <TextBox x:Name="Macro1NameBox" Grid.Row="1" Grid.Column="0" Tag="0" Margin="2" LostFocus="MacroName_LostFocus" />
                                <Button x:Name="Macro1HotkeyButton" Grid.Row="1" Grid.Column="1" Tag="Macro1" Margin="2" Click="HotkeyCaptureButton_Click" />
                                <Slider x:Name="Macro1SpeedSlider" Grid.Row="1" Grid.Column="2" Tag="0" Minimum="0.5" Maximum="4" Value="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="MacroSpeedSlider_ValueChanged" />
                                <TextBlock x:Name="Macro1StepLabel" Grid.Row="1" Grid.Column="3" Foreground="White" VerticalAlignment="Center" />
                                <Button Grid.Row="1" Grid.Column="4" Tag="0" Content="Clear" Margin="2" Click="ClearMacroButton_Click" />

                                <TextBox x:Name="Macro2NameBox" Grid.Row="2" Grid.Column="0" Tag="1" Margin="2" LostFocus="MacroName_LostFocus" />
                                <Button x:Name="Macro2HotkeyButton" Grid.Row="2" Grid.Column="1" Tag="Macro2" Margin="2" Click="HotkeyCaptureButton_Click" />
                                <Slider x:Name="Macro2SpeedSlider" Grid.Row="2" Grid.Column="2" Tag="1" Minimum="0.5" Maximum="4" Value="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="MacroSpeedSlider_ValueChanged" />
                                <TextBlock x:Name="Macro2StepLabel" Grid.Row="2" Grid.Column="3" Foreground="White" VerticalAlignment="Center" />
                                <Button Grid.Row="2" Grid.Column="4" Tag="1" Content="Clear" Margin="2" Click="ClearMacroButton_Click" />

                                <TextBox x:Name="Macro3NameBox" Grid.Row="3" Grid.Column="0" Tag="2" Margin="2" LostFocus="MacroName_LostFocus" />
                                <Button x:Name="Macro3HotkeyButton" Grid.Row="3" Grid.Column="1" Tag="Macro3" Margin="2" Click="HotkeyCaptureButton_Click" />
                                <Slider x:Name="Macro3SpeedSlider" Grid.Row="3" Grid.Column="2" Tag="2" Minimum="0.5" Maximum="4" Value="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="MacroSpeedSlider_ValueChanged" />
                                <TextBlock x:Name="Macro3StepLabel" Grid.Row="3" Grid.Column="3" Foreground="White" VerticalAlignment="Center" />
                                <Button Grid.Row="3" Grid.Column="4" Tag="2" Content="Clear" Margin="2" Click="ClearMacroButton_Click" />

                                <TextBox x:Name="Macro4NameBox" Grid.Row="4" Grid.Column="0" Tag="3" Margin="2" LostFocus="MacroName_LostFocus" />
                                <Button x:Name="Macro4HotkeyButton" Grid.Row="4" Grid.Column="1" Tag="Macro4" Margin="2" Click="HotkeyCaptureButton_Click" />
                                <Slider x:Name="Macro4SpeedSlider" Grid.Row="4" Grid.Column="2" Tag="3" Minimum="0.5" Maximum="4" Value="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="MacroSpeedSlider_ValueChanged" />
                                <TextBlock x:Name="Macro4StepLabel" Grid.Row="4" Grid.Column="3" Foreground="White" VerticalAlignment="Center" />
                                <Button Grid.Row="4" Grid.Column="4" Tag="3" Content="Clear" Margin="2" Click="ClearMacroButton_Click" />

                                <TextBox x:Name="Macro5NameBox" Grid.Row="5" Grid.Column="0" Tag="4" Margin="2" LostFocus="MacroName_LostFocus" />
                                <Button x:Name="Macro5HotkeyButton" Grid.Row="5" Grid.Column="1" Tag="Macro5" Margin="2" Click="HotkeyCaptureButton_Click" />
                                <Slider x:Name="Macro5SpeedSlider" Grid.Row="5" Grid.Column="2" Tag="4" Minimum="0.5" Maximum="4" Value="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="MacroSpeedSlider_ValueChanged" />
                                <TextBlock x:Name="Macro5StepLabel" Grid.Row="5" Grid.Column="3" Foreground="White" VerticalAlignment="Center" />
                                <Button Grid.Row="5" Grid.Column="4" Tag="4" Content="Clear" Margin="2" Click="ClearMacroButton_Click" />

                                <TextBox x:Name="Macro6NameBox" Grid.Row="6" Grid.Column="0" Tag="5" Margin="2" LostFocus="MacroName_LostFocus" />
                                <Button x:Name="Macro6HotkeyButton" Grid.Row="6" Grid.Column="1" Tag="Macro6" Margin="2" Click="HotkeyCaptureButton_Click" />
                                <Slider x:Name="Macro6SpeedSlider" Grid.Row="6" Grid.Column="2" Tag="5" Minimum="0.5" Maximum="4" Value="1.5" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="MacroSpeedSlider_ValueChanged" />
                                <TextBlock x:Name="Macro6StepLabel" Grid.Row="6" Grid.Column="3" Foreground="White" VerticalAlignment="Center" />
                                <Button Grid.Row="6" Grid.Column="4" Tag="5" Content="Clear" Margin="2" Click="ClearMacroButton_Click" />
                            </Grid>

                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Pointer sensitivity" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider x:Name="SensitivitySlider" Width="130" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" />
                            </StackPanel>
                            <CheckBox x:Name="SyncPointersCheckBox"
                                      Margin="0,12,0,8"
                                      IsChecked="True"
                                      Checked="SyncPointersCheckBox_Changed"
                                      Unchecked="SyncPointersCheckBox_Changed"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      Content="Align iPhone pointer with Windows cursor" />
                        </StackPanel>
                    </ScrollViewer>

                    <controls:Canvas HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Width="24"
                                     Height="24">
                        <controls:Canvas.Cursor>
                            <Cursor>SizeNWSE</Cursor>
                        </controls:Canvas.Cursor>
                        <controls:Canvas.Background>
                            <SolidColorBrush Color="#8038A7FF" />
                        </controls:Canvas.Background>
                        <controls:Canvas.InputBindings>
                        </controls:Canvas.InputBindings>
                        <controls:Canvas.RenderTransform>
                            <RotateTransform Angle="0" />
                        </controls:Canvas.RenderTransform>
                        <controls:Canvas x:Name="ResizeGrip"
                                         Width="24"
                                         Height="24"
                                         Background="Transparent"
                                         MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                                         MouseMove="ResizeGrip_MouseMove"
                                         MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" />
                    </controls:Canvas>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
